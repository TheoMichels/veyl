{
  "name": "veyl",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "node scripts/setup-local-db.mjs && node scripts/dev-web.mjs",
    "dev": "npm run web",
    "setup:db": "node scripts/setup-local-db.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "build": "EXPO_NO_TELEMETRY=1 npx expo export -p web --clear",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@prisma/client": "^5.22.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.15",
    "expo-linear-gradient": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "rss-parser": "^3.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "prisma": "^5.22.0",
    "typescript": "~6.0.3"
  }
}

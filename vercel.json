{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/cron/:category",
      "destination": "/api/cron/[category]?category=:category"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ia",
      "schedule": "0 3 * * 1-5"
    },
    {
      "path": "/api/cron/luxembourg",
      "schedule": "0 3 * * 5"
    },
    {
      "path": "/api/cron/tech",
      "schedule": "0 3 * * 1-5"
    }
  ]
}

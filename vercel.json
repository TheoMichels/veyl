{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ia",
      "schedule": "0 3 * * 1-5"
    },
    {
      "path": "/api/cron/luxembourg",
      "schedule": "0 3 * * 5"
    },
    {
      "path": "/api/cron/tech",
      "schedule": "0 3 * * 1-5"
    }
  ]
}

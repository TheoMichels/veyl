# Client (publiques, incorporées au build Expo)
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# PostgreSQL Connection Strings (Prisma)
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DIRECT_URL=postgres://postgres.<ref>:<password>@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Server & Secret Keys (Vercel / Backend / Scripts)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Gemini API Key (Vercel serverless functions / scripts)
GEMINI_API_KEY=your_gemini_api_key_here

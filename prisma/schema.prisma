datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Les éditions globales de veille (Briefing)
model Digest {
  id          String   @id @default(cuid())
  category    String   // 'IA' ou 'Luxembourg'
  title       String   // ex: "Veille IA du 22 Septembre"
  content     String   // Contenu markdown/HTML de la synthèse (généré par l'IA)
  createdAt   DateTime @default(now())
}

model Source {
  id        String    @id @default(cuid())
  name      String
  url       String    @unique
  category  String    // 'IA' ou 'Luxembourg'
  isActive  Boolean   @default(true)
}

model Settings {
  id              String   @id @default("default")
  geminiPromptIA  String
  geminiPromptLux String
  geminiPromptTech String  @default("Tu es un journaliste tech. Résume les nouveautés matérielles (hardware) et logicielles (software). Structure avec des puces et ajoute les liens sources.")
  cronEnabled     Boolean  @default(true)
}
